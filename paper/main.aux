\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Matched drivers, cold caches, compute phase. Geometric mean of the paired ratio baseline/candidate ($>1$: symq faster) with a 95\% bootstrap interval; in parentheses, wins/circuits completed by both, and circuits not completed (n/c) by at least one side. Modes: \textsf  {nat-loop}: symq native, minimal loop; \textsf  {pb-loop}: PolyBoRi, minimal loop; \textsf  {nat-sorted}: symq native, minimal loop, sorted; \textsf  {pb-sorted}: PolyBoRi, minimal loop, sorted; \textsf  {nat-fused}: symq native, fused C loop; \textsf  {pb-best}: PolyBoRi, best of its three drivers; \textsf  {bdd-loop}: CUDD BDD, minimal loop (reordering); \textsf  {bdd-static}: CUDD BDD, minimal loop (static order).}}{5}{table.1}\protected@file@percent }
\newlabel{tab:matched}{{1}{5}{Matched drivers, cold caches, compute phase. Geometric mean of the paired ratio baseline/candidate ($>1$: symq faster) with a 95\% bootstrap interval; in parentheses, wins/circuits completed by both, and circuits not completed (n/c) by at least one side. Modes: \textsf {nat-loop}: symq native, minimal loop; \textsf {pb-loop}: PolyBoRi, minimal loop; \textsf {nat-sorted}: symq native, minimal loop, sorted; \textsf {pb-sorted}: PolyBoRi, minimal loop, sorted; \textsf {nat-fused}: symq native, fused C loop; \textsf {pb-best}: PolyBoRi, best of its three drivers; \textsf {bdd-loop}: CUDD BDD, minimal loop (reordering); \textsf {bdd-static}: CUDD BDD, minimal loop (static order)}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Ablation of the native engine (cold compute phase). Each row changes one thing: the engine (C instead of Python, same driver), the driver (minimal loop instead of symq's \texttt  {Algebra} layer), factor sorting, and fusing the loop in C. Ratios below 1 are slowdowns. Modes: \textsf  {nat-alg}: symq native, \texttt  {Algebra} driver; \textsf  {py-alg}: symq Python ZDD, \texttt  {Algebra} driver; \textsf  {nat-loop}: symq native, minimal loop; \textsf  {nat-sorted}: symq native, minimal loop, sorted; \textsf  {nat-fused}: symq native, fused C loop.}}{5}{table.2}\protected@file@percent }
\newlabel{tab:ablation}{{2}{5}{Ablation of the native engine (cold compute phase). Each row changes one thing: the engine (C instead of Python, same driver), the driver (minimal loop instead of symq's \texttt {Algebra} layer), factor sorting, and fusing the loop in C. Ratios below 1 are slowdowns. Modes: \textsf {nat-alg}: symq native, \texttt {Algebra} driver; \textsf {py-alg}: symq Python ZDD, \texttt {Algebra} driver; \textsf {nat-loop}: symq native, minimal loop; \textsf {nat-sorted}: symq native, minimal loop, sorted; \textsf {nat-fused}: symq native, fused C loop}{table.2}{}}
